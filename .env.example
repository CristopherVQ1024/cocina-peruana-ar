GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# respaldo en orden si el principal falla o tarda
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# segundos por intento y tope de todos los intentos juntos
GEMINI_TIMEOUT_S=8
GEMINI_TIMEOUT_TRADUCIR_S=15
GEMINI_TIMEOUT_TOTAL_S=55
WEB_PORT=8090
